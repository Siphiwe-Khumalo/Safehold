# Copy to .env and adjust as needed.

# Server
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://safehold:safehold@localhost:5432/safehold

# Public base URL of the FRONTEND, used to build tracking links in notifications.
PUBLIC_APP_URL=http://localhost:5173

# --- Notifications (Milestone 6) ---
# Leave the provider as "console" for local dev; alerts are logged, not sent.
# Options: console | smtp
NOTIFY_PROVIDER=console

# SMTP settings (only used when NOTIFY_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SafeHold <alerts@example.com>"

# SMS provider is not implemented in the MVP (requires an external account
# such as Twilio/Clickatell). See src/notifications/README.md.
